# THING//MANIA — Local Backend Configuration
# Copy this file to .env and fill in your values.
# .env is listed in .gitignore and MUST NEVER be committed to git.

# ── Meta Model API (required for live inference; leave blank for mock mode) ───
MODEL_API_KEY=
MODEL_ENDPOINT=https://api.meta.ai/v1/chat/completions
MODEL_NAME=muse-spark-1.3

# ── Spending & safety controls ────────────────────────────────────────────────
# MOCK_MODE=false enables live API calls. Keep true until you're ready.
MOCK_MODE=true
MAX_SESSION_CALLS=10
MAX_SESSION_BUDGET_USD=1.00
REQUEST_TIMEOUT_MS=15000
MAX_RETRIES=2

# ── Token pricing (update if Meta publishes revised rates) ────────────────────
COST_PER_1K_INPUT_USD=0.0015
COST_PER_1K_OUTPUT_USD=0.0020

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
