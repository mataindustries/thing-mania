# THING//MANIA — Local Backend Configuration
# First live test: prefer temporary environment variables (no key file).
# Node server.js does NOT load .env automatically. If you create .env, use node --env-file=.env server.js.
# Do not expose the local development server to the public Internet.
# .env is listed in .gitignore and MUST NEVER be committed to git.

# ── Meta Model API (required for live inference; leave blank for mock mode) ───
MODEL_API_KEY=
MODEL_ENDPOINT=https://api.meta.ai/v1/chat/completions
MODEL_NAME=muse-spark-1.3

# ── Spending & safety controls ────────────────────────────────────────────────
# MOCK_MODE=false enables live API calls. Keep true until you're ready.
MOCK_MODE=true
MAX_SESSION_CALLS=1
MAX_SESSION_BUDGET_USD=0.05
REQUEST_TIMEOUT_MS=15000
MAX_RETRIES=0

# ── Token pricing (update if Meta publishes revised rates) ────────────────────
COST_PER_1K_INPUT_USD=0.00125
COST_PER_1K_OUTPUT_USD=0.00425

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
